{% set footer__base_class = 'footer' %}
{% set copyright = 'Todos los derechos reservados Copyrights.' | t %}

<footer {{ bem(footer__base_class) }}>
	<div class="container">
		<div class="first_footer">
			<div class="row justify-content-between">
				<div class="col-sm-12 col-md-6 col-xl-3">
					<div class="about">
						{% block footer__about %}
							{% include "@atoms/images/image/responsive-image.twig" with {
                output_image_tag: true,
                image_src: field_logo_footer,
                image_alt: 'Logo',
              } %}
							{% include "@atoms/text/text/01-paragraph.twig" with {
                paragraph_content: 'body'
              } %}
						{% endblock %}
					</div>
				</div>
				<div class="col-sm-12 col-md-6 col-xl-3">
					{% include "@atoms/text/text/01-paragraph.twig" with {
            paragraph_content: 'column'
          } %}
				</div>
				<div class="col-sm-12 col-md-6 col-xl-3">
					<div class="subscribe">
						{% include "@atoms/text/text/01-paragraph.twig" with {
              paragraph_content: 'column'
            } %}
					</div>
				</div>
				<div class="col-sm-12 col-md-6 col-xl-3">
					{% block footer__copyright %}
						<div class="copyrights">
							<p>
								&copy; Gallo pinto<br>
								{{ copyright }}
								{{ "now"|date("Y") }}
							</p>
						</div>
					{% endblock %}
				</div>
			</div>
		</div>
	</div>
</footer>
